<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- The Bluetooth permissions below would otherwise make the feature mandatory; a TV without it just hides the capsule. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Granted over adb (AGENTS.md step 4) or through local adb from 主屏幕设置, never asked on screen:
         - WRITE_SECURE_SETTINGS: switch the home guard back on after the firmware switched it off,
           keep ADB debugging on, keep the photo frame as the screensaver, Xiaomi backlight.
         - SYSTEM_ALERT_WINDOW: Android's exemption for opening the home screen right after boot; also,
           while notification banners are on (the default), showing them over the app in front. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The sleep timer's alarm (SleepTimer). Granted at install for an app of this target version;
         where Android refuses it, the timer falls back to an inexact alarm. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The Top Shelf (Shelf.kt): the Watch Next programs ("Continuer à regarder") other apps publish
         to TvProvider, which answers them to the system's home and to holders of this permission only.
         TvProvider defines it as a runtime ("dangerous") permission: granted over adb (AGENTS.md
         step 4) or through local adb (Guard.grantViaLocalAdb), never asked on screen. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- The Bluetooth capsule of the Control Center (Bluetooth.kt): lists the paired devices and connects or
         disconnects the audio ones. Android 12 split these in two: BLUETOOTH_CONNECT is asked on screen the
         first time the capsule is pressed, or granted over adb (AGENTS.md step 4). Nothing is scanned. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TVHome">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing" />
        <!-- The HOME (standard) or launcher (guard) intent filter comes from the flavor's manifest.
             No excludeFromRecents: where canvasOS is not the system home, Android trims an excluded
             task as soon as it leaves the front, and the guard would bring back a fresh screen. -->

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:banner="@drawable/banner_settings"
            android:label="@string/settings_name"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The first-launch assistant: HomeActivity opens it on a fresh install until it is finished. -->
        <activity
            android:name=".OnboardingActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TVHome"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan" />

        <activity
            android:name=".FrameActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TVHome" />

        <service
            android:name=".PhotoDream"
            android:exported="true"
            android:label="Cadre photo"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".KeeperService"
            android:exported="false" />

        <!-- The sleep timer's alarm; only the app's own PendingIntent reaches it. -->
        <receiver
            android:name=".SleepReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The 壁纸 app on the home grid: pick a background, or set one up from a phone. -->
        <activity
            android:name=".WallpaperActivity"
            android:banner="@drawable/banner_wallpaper"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TVHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Options set from a computer with am broadcast (see ConfigReceiver and AGENTS.md).
             Only the adb shell (and the system) hold this permission. -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.getisolated.canvasos.CONFIG" />
            </intent-filter>
        </receiver>

        <service
            android:name=".HomeGuardService"
            android:exported="true"
            android:label="@string/guard_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_guard" />
        </service>

        <!-- Notification listener: Android binds it again after the firmware kills canvasOS, which
             brings the home guard back (Guard.kt), and it lets canvasOS list media sessions (the
             package and playback state, for the memory cleanup; with "Lecture en cours" on, the
             default, also the title, artist and artwork). With notification banners on, the default
             (Réglages → Lecture et notifications), it reads the title and text of every app's
             notifications except the apps the user excluded, shows them 6 seconds and never stores
             them; with banners off it reads none. Approved over adb (AGENTS.md step 4). -->
        <service
            android:name=".RevivalListener"
            android:exported="true"
            android:label="@string/guard_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
