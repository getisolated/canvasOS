---
import { brand, installCmd, restoreCmd } from "../data/site";
import { getCopy } from "../data/copy";
import type { Locale } from "../data/lang";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = getCopy(locale).install;
/* the APK, then the releases page */
const hrefs = [brand.apk, brand.releases];
---
<section class="section install" id="install">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2>{s.title}</h2>
      <p class="lede">{s.lede}</p>
    </div>

    <div class="downloads reveal">
      {s.downloads.map((d, i) => (
        <a class="download" href={hrefs[i]} rel="noopener">
          <span class="name">{d.name}</span>
          <span class="use">{d.use}</span>
          <span class="arrow">{d.cta} <svg aria-hidden="true"><use href="#i-arrow"></use></svg></span>
        </a>
      ))}
    </div>

    <div class="prereq reveal">{s.prereq}</div>

    <div class="agent-card reveal">
      <h3><svg aria-hidden="true"><use href="#i-terminal"></use></svg>{s.agent.title}</h3>
      <p>{s.agent.body}</p>
      <div class="prompt-box">
        <p id="cmd-agent">{s.agent.prompt}</p>
        <button class="copy" type="button" data-copy="#cmd-agent">
          <svg aria-hidden="true"><use href="#i-copy"></use></svg>
          <span class="label"></span>
        </button>
      </div>
      <p class="fine">{s.agent.note}</p>
    </div>

    <div class="quick-install reveal">
      <article class="quick-card">
        <p class="eyebrow">{s.quick.eyebrow}</p>
        <h3>{s.quick.title}</h3>
        <p>{s.quick.body}</p>
        <div class="code"><pre><code id="cmd-quick-install">{installCmd}</code></pre><button class="copy" data-copy="#cmd-quick-install" type="button"><span class="label"></span></button></div>
        <p class="fine" set:html={s.quick.note} />
      </article>
      <article class="quick-card">
        <p class="eyebrow">{s.update.eyebrow}</p>
        <h3>{s.update.title}</h3>
        <p>{s.update.body}</p>
        <details>
          <summary>{s.update.restoreSummary}</summary>
          <p>{s.update.restoreBody}</p>
          <div class="code"><pre><code id="cmd-quick-restore">{restoreCmd}</code></pre><button class="copy" data-copy="#cmd-quick-restore" type="button"><span class="label"></span></button></div>
        </details>
        <a class="text-link" href="/agent.md">{s.update.guideLink}</a>
      </article>
    </div>

    <details class="manual-install">
      <summary>{s.manualSummary}</summary>
      <div class="table-wrap brand-table">
        <table>
          <caption>{s.adbTable.caption}</caption>
          <thead>
            <tr>{s.adbTable.head.map((h) => <th scope="col">{h}</th>)}</tr>
          </thead>
          <tbody>
            {s.adbTable.rows.map((row) => (
              <tr>
                <th scope="row">{row[0]}</th>
                <td set:html={row[1]} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="windows-note" set:html={s.allowNote} />

      <details class="faq advanced">
        <summary>{s.advanced.title}</summary>
        <div class="faq-body">
          <p>{s.advanced.body}</p>
          <div class="table-wrap">
            <table>
              <thead><tr>{s.advanced.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>
                {s.advanced.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td></tr>)}
              </tbody>
            </table>
          </div>
        </div>
      </details>
    </details>

    <div class="callout is-danger reveal">
      <svg aria-hidden="true"><use href="#i-warning"></use></svg>
      <span set:html={s.safety} />
    </div>
  </div>
</section>
