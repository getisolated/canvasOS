---
import Clip from "./Clip.astro";
import { brand, device, deviceOs } from "../data/site";
import { slot, anyVideo } from "../data/media";
import { getCopy } from "../data/copy";
import type { Locale } from "../data/lang";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const hero = copy.hero;
const t = copy.ui;
const home = slot("home");
const live = home.video ? t.recording : t.still;
const size = home.video ? "1280 × 720" : "1920 × 1080";
---
<section class="hero">
  <div class="hero-aurora" aria-hidden="true">
    <span class="aurora-blob blob-a"></span>
    <span class="aurora-blob blob-b"></span>
    <span class="aurora-blob blob-c"></span>
  </div>

  <div class="wrap hero-center">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>
      <span class="line">{hero.titleLines[0]}</span>
      <span class="line accent">{hero.titleLines[1]}</span>
    </h1>
    <p class="hero-sub">{hero.sub}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={brand.apk} rel="noopener">
        <svg aria-hidden="true"><use href="#i-download"></use></svg>
        {hero.primary}
      </a>
      <a class="btn btn-ghost" href="#install">
        {hero.secondary}
        <svg aria-hidden="true"><use href="#i-arrow"></use></svg>
      </a>
    </div>
    <ul class="hero-meta">
      <li class="chip"><span class="dot"></span>{hero.chips[0]}</li>
      {hero.chips.slice(1).map((chip) => <li class="chip">{chip}</li>)}
    </ul>
  </div>

  <div class="wrap hero-stage">
    <div class="tv-stage">
      <div class="tv-glow" aria-hidden="true"></div>
      <div class="tv-frame">
        <div class="tv-screen">
          <Clip id="home" alt={hero.alt} eager sizes="(max-width: 1100px) 94vw, 1060px" />
          {anyVideo() && (
            <button class="clip-toggle" type="button" data-clip-toggle aria-pressed="false"
              aria-label={t.pauseClips} data-label-pause={t.pauseClips} data-label-play={t.playClips}>
              <svg viewBox="0 0 16 16" aria-hidden="true"><rect class="i-pause" x="4" y="3" width="3" height="10" rx="1"/><rect class="i-pause" x="9" y="3" width="3" height="10" rx="1"/><path class="i-play" d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5z"/></svg>
            </button>
          )}
        </div>
      </div>
      <div class="float-chip chip-shelf" aria-hidden="true">
        <span class="glyph"><svg><use href="#i-play"></use></svg></span>
        <span><strong>{hero.chipAerial.title}</strong><small>{hero.chipAerial.sub}</small></span>
      </div>
      <div class="float-chip chip-dock" aria-hidden="true">
        <span class="glyph"><svg><use href="#i-check"></use></svg></span>
        <span><strong>{hero.chipDock.title}</strong><small>{hero.chipDock.sub}</small></span>
      </div>
    </div>
    <p class="tv-caption">
      <span class="live">{live} · {device} · {deviceOs}</span>
      <span>{size}</span>
    </p>
    <p class="hero-note">{hero.note}</p>
  </div>
</section>

<div class="proof">
  <div class="wrap proof-inner">
    {copy.proof.map((item) => (
      <span class="proof-item"><svg aria-hidden="true"><use href="#i-check"></use></svg>{item}</span>
    ))}
  </div>
</div>

<section class="release-strip wrap" aria-label={copy.release.label}>
  <a class="release-pill" href={brand.releases} rel="noopener"><span class="dot"></span>{copy.release.pill}</a>
  <div class="release-grid">
    {copy.release.cards.map((card, i) => (
      <article>
        <span class="release-number">{String(i + 1).padStart(2, "0")}</span>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </article>
    ))}
  </div>
</section>
