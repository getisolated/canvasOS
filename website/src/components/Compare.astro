---
/* Before / after. "After" is the home slot (capture, or home.mp4 once supplied). "Before" is
   the owner's capture at public/img/before.webp, or a labelled illustration until then. */
import Clip from "./Clip.astro";
import { beforeImage, slot } from "../data/media";
import { getCopy } from "../data/copy";
import type { Locale } from "../data/lang";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const c = copy.compare;
const t = copy.ui;
const before = beforeImage(locale);
const afterIsVideo = Boolean(slot("home").video);
---
<section class="section compare-section" id="compare">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="lede" set:html={before.isCapture ? c.ledeCapture : c.ledeIllustration} />
    </div>

    <div class="compare-wrap reveal">
      <div class="compare" data-compare>
        <div class="compare-after">
          <Clip id="home" alt={c.afterAlt} sizes="(max-width: 900px) 96vw, 1100px" />
        </div>
        <div class="compare-before">
          <img
            src={before.src}
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            alt={before.isCapture ? c.beforeAltCapture : c.beforeAltIllustration}
          />
        </div>

        <div class="compare-label is-before">{c.beforeLabel}<span>{before.isCapture ? c.beforeSubCapture : c.beforeSubIllustration}</span></div>
        <div class="compare-label is-after">{c.afterLabel}<span>{afterIsVideo ? `canvasOS · ${t.recording.toLowerCase()}` : c.afterSub}</span></div>

        <div
          class="compare-handle"
          role="slider"
          tabindex="0"
          aria-label={t.compareName}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          aria-valuetext={t.compareValue.replace("{p}", "50")}
          aria-orientation="horizontal"
          data-valuetemplate={t.compareValue}
        >
          <div class="grip" aria-hidden="true">
            <svg viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 2 6 7l-4 5"></path></svg>
            <svg viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" style="transform:rotate(180deg)"><path d="M2 2 6 7l-4 5"></path></svg>
          </div>
        </div>
      </div>
    </div>

    <div class="compare-hint reveal">
      <span>{c.hint}</span>
      <span>{before.isCapture ? c.disclaimerCapture : c.disclaimerIllustration}</span>
    </div>
  </div>
</section>
