---
import { getCopy } from "../data/copy";
import type { Locale } from "../data/lang";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getCopy(locale).compatibility;
---
<section class="section compatibility-section" id="compatibility">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
      <p class="lede">{c.lede}</p>
    </div>

    <div class="table-wrap reveal">
      <table>
        <caption>{c.caption}</caption>
        <thead>
          <tr>{c.head.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
          {c.rows.map((row) => (
            <tr>
              <th scope="row">{row.cells[0]}</th>
              {row.tones.map((tone, i) => <td class={tone}>{row.cells[i + 1]}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="notes reveal">
      {c.notes.map((n) => (
        <div class="note">
          <strong>{n.title}</strong>
          {n.body}
        </div>
      ))}
    </div>

    <div class="callout reveal">
      <svg aria-hidden="true"><use href="#i-info"></use></svg>
      <span set:html={c.scope} />
    </div>
  </div>
</section>
