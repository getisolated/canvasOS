---
import { getCopy } from "../data/copy";
import type { Locale } from "../data/lang";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const f = getCopy(locale).faq;
---
<section class="section faq-section" id="faq">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2>{f.title}</h2>
    </div>

    <div class="faq-list reveal">
      {f.items.map((item, idx) => (
        <details class="faq">
          <summary>{item.q}</summary>
          <div class="faq-body">
            {item.a.map((p) => <p set:html={p} />)}
            {item.cmds?.map((cmd, i) => (
              <div class="code">
                <pre><code id={`cmd-faq-${idx}-${i}`}>{cmd}</code></pre>
                <button class="copy" type="button" data-copy={`#cmd-faq-${idx}-${i}`}>
                  <svg aria-hidden="true"><use href="#i-copy"></use></svg>
                  <span class="label"></span>
                </button>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
