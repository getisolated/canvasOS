---
import { slot } from "../data/media";
import { getCopy } from "../data/copy";
import type { Locale } from "../data/lang";
import type { SlotId } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const g = copy.gallery;
const t = copy.ui;

/* Grid cells (two wide, then three) and the slot each one shows, in g.items order. */
const cells: { cell: string; id: SlotId }[] = [
  { cell: "g-home", id: "intro" },
  { cell: "g-shelf", id: "shelf" },
  { cell: "g-grid", id: "settings" },
  { cell: "g-cc", id: "cc" },
  { cell: "g-frame", id: "aerial" },
];
const items = cells.map((c, i) => ({ ...c, ...g.items[i], media: slot(c.id) }));
---
<section class="section gallery-section" id="gallery">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{g.eyebrow}</p>
      <h2>{g.title}</h2>
      <p class="lede">{g.lede}</p>
    </div>
    <p class="fine">{g.fine}</p>

    <div class="gallery reveal">
      {items.map((item, i) => (
        <figure class={item.cell}>
          <button
            type="button"
            data-lightbox-open
            data-full={item.media.video ?? item.media.poster}
            data-poster={item.media.poster}
            data-video={item.media.video ? "" : undefined}
            data-caption={item.caption}
            data-alt={item.alt}
            aria-label={item.caption}
          >
            {item.media.video ? (
              <video
                data-clip
                src={item.media.video}
                poster={item.media.poster}
                width="1280"
                height="720"
                muted
                loop
                playsinline
                preload="none"
                aria-label={item.alt}
              ></video>
            ) : (
              <img
                src={item.media.small}
                srcset={`${item.media.small} 640w, ${item.media.poster} 1280w`}
                sizes={i < 2 ? "(max-width: 860px) 92vw, 540px" : "(max-width: 520px) 92vw, (max-width: 860px) 46vw, 360px"}
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
                alt={item.alt}
              />
            )}
          </button>
          <figcaption>{item.caption} <em>{item.media.file}</em></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-label={t.viewer}>
  <div class="lightbox-inner">
    <button class="lightbox-close" type="button" data-close aria-label={t.close}>
      <svg aria-hidden="true"><use href="#i-close"></use></svg>
    </button>
    <img alt="" hidden />
    <video autoplay muted loop playsinline preload="metadata" hidden></video>
    <div class="lightbox-bar">
      <span data-lightbox-caption></span>
      <span data-lightbox-counter>1 / {items.length}</span>
      <span class="nav-btns">
        <button type="button" data-prev aria-label={t.prev}><svg aria-hidden="true" style="transform:rotate(180deg)"><use href="#i-chevron"></use></svg></button>
        <button type="button" data-next aria-label={t.next}><svg aria-hidden="true"><use href="#i-chevron"></use></svg></button>
      </span>
    </div>
  </div>
</dialog>
