---
/* The screensaver section. Until public/video/aerial.mp4 is supplied it shows the real
   capture of the photo frame screensaver (Photos content) and says so. */
import Clip from "./Clip.astro";
import { slot } from "../data/media";
import { getCopy } from "../data/copy";
import type { Locale } from "../data/lang";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const a = getCopy(locale).aerial;
const isVideo = Boolean(slot("aerial").video);
---
<section class="section aerial-section" id="aerial">
  <div class="wrap">
    <div class="aerial-head reveal">
      <p class="eyebrow">{a.eyebrow}</p>
      <h2>{a.title}</h2>
      <p class="lede">{a.lede}</p>
    </div>

    <div class="aerial-stage reveal">
      <div class="aerial-glow" aria-hidden="true"></div>
      <div class="tv-frame aerial-frame">
        <div class="tv-screen aerial-screen">
          <Clip id="aerial" alt={isVideo ? a.altVideo : a.altStill} sizes="(max-width: 1100px) 94vw, 1060px" />
          <span class="aerial-badge">{isVideo ? a.badgeVideo : a.badgeStill}</span>
        </div>
      </div>
    </div>

    <div class="aerial-foot reveal">
      <p class="aerial-caption">{isVideo ? a.captionVideo : a.captionStill}</p>
      <ul class="aerial-points">
        {a.points.map((p) => <li>{p}</li>)}
      </ul>
      <p class="aerial-attribution">{a.attribution}</p>
    </div>
  </div>
</section>
