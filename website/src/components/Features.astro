---
import { shots } from "../data/site";
import type { Copy, Locale } from "../data/lang";

interface Props {
  copy: Copy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const f = copy.features;

/* Feature sections. Each one uses an authentic capture; nothing is fabricated.
   TODO(captures, v1.1): every image below was taken on the Sony BRAVIA before 1.1. To redo on a
   real TV: 02 Top Shelf (a Watch Next / TMDB row instead of Bilibili), 03 Control Center (weather,
   Bluetooth, Now playing and the sleep-timer sheet), 01 Home (profile avatar, a folder, the Dock
   setting). The text-only cards further down (copy.features.groups) have no capture yet. */
const items = [
  {
    num: "01",
    kicker: "LIQUID GLASS DOCK",
    title: locale === "zh" ? "Un verre qui s'enfonce, des icônes qui flottent" : "A dock that sinks into the picture",
    body:
      locale === "zh"
        ? "La première rangée d'apps repose sur une plaque de verre posée en bas de l'écran ; la suivante ne laisse voir que son bord. Appuyez sur Bas pour afficher toutes les apps ; le reste du temps, l'écran appartient au fond d'écran."
        : "The first row sits on a sunken glass plate; the next row shows only its top edge. Press Down to reveal every app, or leave the screen to the wallpaper.",
    bullets:
      locale === "zh"
        ? [
            "5 colonnes d'icônes arrondies en 16:9, qui s'agrandissent, s'inclinent et projettent une ombre au focus",
            "Appui long pour modifier, puis déplacez les icônes vers le Dock ou n'importe où avec les flèches ; Récents ou Fixe, au choix",
            "Flou, réfraction des bords et reflets colorés sont précalculés pour chaque fond : le défilement ne sollicite pas davantage le GPU",
          ]
        : [
            "Five 16:9 rounded tiles that scale and tilt with a soft shadow on focus",
            "Long-press to edit, then move tiles into the dock with the D-pad; Recents or Fixed, your choice",
            "Blur, edge refraction and highlights are precomputed per wallpaper on the CPU",
          ],
    img: shots.home,
    alt:
      locale === "zh"
        ? "Capture réelle du Dock en verre liquide : cinq icônes d'apps sur une plaque de verre, avec réfraction et reflets sur les bords."
        : "Liquid-glass dock with five app tiles on a Sony BRAVIA.",
    caption: locale === "zh" ? "Accueil · capture réelle sur Sony BRAVIA" : "Home screen · Sony BRAVIA capture",
    flip: false,
  },
  {
    num: "02",
    kicker: "TOP SHELF",
    title: locale === "zh" ? "Sélectionnez une app, le haut de l'écran prend vie" : "Focus an app and the top half starts living",
    body:
      locale === "zh"
        ? "Quand le focus se pose sur une app du Dock, la moitié haute de l'écran fait défiler ses contenus, une image toutes les 8 secondes ; OK ouvre l'app. Ce que l'app publie elle-même passe en premier, puis les titres populaires du moment."
        : "When the focus lands on a dock app, the upper half cycles through its content, one picture every 8 seconds; OK opens the app. What the app publishes itself comes first, then what is popular right now.",
    bullets:
      locale === "zh"
        ? [
            "La ligne « Continuer à regarder » publiée par Netflix, YouTube, Prime… pour l'accueil d'Android TV, lue sur la TV (autorisation READ_TV_LISTINGS)",
            "Sinon, les titres populaires de la semaine en France d'après TMDB pour Netflix, Prime Video, Disney+, Apple TV, Max, Paramount+, Canal+ et Crunchyroll, avec votre propre clé d'API gratuite",
            "Enfin, les vidéos tendance de Bilibili et les directs de Douyu (API web publiques, sans compte)",
          ]
        : [
            "The “Continue watching” row that Netflix, YouTube, Prime… publish for the Android TV home screen, read on the TV (READ_TV_LISTINGS grant)",
            "Otherwise, this week's popular titles in France from TMDB for Netflix, Prime Video, Disney+, Apple TV, Max, Paramount+, Canal+ and Crunchyroll, with your own free API key",
            "Last, Bilibili trending videos and Douyu live rooms (public web endpoints, no account)",
          ],
    img: shots.shelf,
    alt:
      locale === "zh"
        ? "Capture réelle du Top Shelf : en haut, l'image et le titre d'une vidéo tendance de Bilibili ; en bas, le Dock en verre."
        : "Top Shelf showing a Bilibili video above the dock.",
    caption: locale === "zh" ? "Top Shelf · capture réelle, source Bilibili" : "Top Shelf · real capture, Bilibili source",
    flip: true,
  },
  {
    num: "03",
    kicker: "CONTROL CENTER",
    title: locale === "zh" ? "Une pression sur Retour, et le Centre de contrôle apparaît" : "One Back press away",
    body:
      locale === "zh"
        ? "Pas de panneau d'un seul bloc, juste des boutons en verre liquide qui flottent séparément. Derrière, l'accueil flouté en temps réel ; devant, les commandes dont vous avez vraiment besoin."
        : "No enclosing panel — just floating liquid-glass controls over a live blur of the wallpaper.",
    bullets:
      locale === "zh"
        ? [
            "Réseau (avec l'adresse IP), veille avec minuteur, extinction, redémarrage, libération de la mémoire, Cadre photo, Réglages",
            "Météo sur cinq jours, Bluetooth, et, si vous l'activez, Lecture en cours",
            "Luminosité et Sources HDMI n'apparaissent que si la TV les prend en charge",
            "Android 12+ partage une couche de flou GPU ; les systèmes plus anciens échantillonnent le fond d'écran",
          ]
        : [
            "Network (with the IP address), standby with a timer, power, restart, memory, photo frame, settings",
            "Five-day weather, Bluetooth and, if you turn it on, Now playing",
            "Brightness and HDMI input appear only where the TV exposes them",
            "Android 12+ reuses a shared GPU blur layer; older systems sample the wallpaper",
          ],
    img: shots.cc,
    alt:
      locale === "zh"
        ? "Capture réelle du Centre de contrôle : à droite flottent les commandes en verre liquide extinction, veille, réseau, luminosité, volume et Sources."
        : "Frosted Control Center with power, network and brightness controls.",
    caption: locale === "zh" ? "Centre de contrôle · boutons de verre flottants" : "Control Center · floating glass controls",
    flip: false,
  },
  {
    num: "04",
    kicker: "WALLPAPER & FRAME",
    title: locale === "zh" ? "Quand la TV se tait, elle devient une fenêtre" : "When the TV is quiet, make it a window",
    body:
      locale === "zh"
        ? "Photos du jour de Bing, paysages de Wikimedia Commons et de la NASA, animaux mignons, chefs-d'œuvre du Met et de l'Art Institute of Chicago, anime, vos propres photos envoyées depuis un téléphone, vos liens d'images ou un dégradé. Changement toutes les 15 minutes à une fois par jour."
        : "Bing daily photos, landscapes from Wikimedia Commons and NASA, cute animals, masterpieces from the Met and the Art Institute of Chicago, anime, your own photos sent from a phone, your own image links, or a colour gradient — rotating every 15 minutes to once a day.",
    bullets:
      locale === "zh"
        ? ["Chaque choix se présente en image et se sélectionne d'un seul appui ; les œuvres du Met et de l'Art Institute sont dans le domaine public", "Le Cadre photo se déplace et zoome lentement, et l'heure change régulièrement de place pour ménager les écrans OLED ; il peut aussi afficher les films aériens de l'Apple TV (voir plus haut)", "Défini comme économiseur d'écran système, il démarre après 1 à 30 minutes d'inactivité de la télécommande"]
        : [
            "Every choice is shown as a picture and picked with one press; the Met and Art Institute works are public domain",
            "The frame pans and zooms slowly, moving the clock to protect OLED panels; it can also show Apple TV aerial films (see above)",
            "Set it as the system screensaver after 1–30 minutes of idle time",
          ],
    img: shots.grid,
    alt:
      locale === "zh"
        ? "Capture réelle de la grille de toutes les apps : plusieurs rangées d'icônes 16:9 sur le fond d'écran."
        : "All-apps grid capture over the wallpaper.",
    caption: locale === "zh" ? "Toutes les apps · grille" : "All apps · grid layout",
    flip: true,
  },
];
---
<section class="section" id="features">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2>{f.title}</h2>
      <p class="lede">{f.lede}</p>
    </div>

    {items.map((item) => (
      <article class:list={["feature reveal", { "is-flipped": item.flip }]}>
        <div class="feature-copy">
          <p class="feature-kicker"><span class="num">{item.num}</span>{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <ul class="feature-list">
            {item.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <figure class="feature-media">
          <div class="tv-frame">
            <div class="tv-screen">
              <img
                src={item.img.src}
                srcset={`${item.img.small} 640w, ${item.img.src} 1280w`}
                sizes="(max-width: 899px) 92vw, 52vw"
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
                alt={item.alt}
              />
            </div>
          </div>
          <figcaption>{item.caption}</figcaption>
        </figure>
      </article>
    ))}

    {/* 1.1 additions without a capture of their own: text-only cards, grouped by theme. */}
    <div class="feature-more">
      <h3 class="reveal">{f.moreTitle}</h3>
      {f.groups.map((group) => (
        <div class="feature-group reveal">
          <h4>{group.title}</h4>
          <div class="notes">
            {group.cards.map((card) => (
              <div class="note">
                <strong>{card.title}</strong>
                {card.body}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
