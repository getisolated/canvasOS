---
import Clip from "./Clip.astro";
import { slot } from "../data/media";
import { getCopy } from "../data/copy";
import type { Locale } from "../data/lang";
import type { SlotId } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const f = copy.features;

/* Media for each feature, in copy order; every one is a real capture or recording. */
const media: SlotId[] = ["home", "shelf", "cc", "aerial", "settings"];
---
<section class="section" id="features">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2>{f.title}</h2>
      <p class="lede">{f.lede}</p>
    </div>

    {f.items.map((item, i) => (
      <article class:list={["feature reveal", { "is-flipped": i % 2 === 1 }]}>
        <div class="feature-copy">
          <p class="feature-kicker"><span class="num">{String(i + 1).padStart(2, "0")}</span>{item.kicker}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <ul class="feature-list">
            {item.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <figure class="feature-media">
          <div class="tv-frame">
            <div class="tv-screen">
              <Clip id={media[i]} alt={slot(media[i]).video ? item.altVideo : item.alt} />
            </div>
          </div>
          <figcaption>{item.caption} · {(slot(media[i]).video ? copy.ui.recording : copy.ui.still).toLowerCase()}</figcaption>
        </figure>
      </article>
    ))}
  </div>
</section>
